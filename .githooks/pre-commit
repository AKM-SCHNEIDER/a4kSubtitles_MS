#!/bin/bash

touch .commit

prefix='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- DO NOT EDIT. -->
<!-- Generated by git commit hooks. -->
<addons>'
suffix='</addons>'
addon=$(tail -n +2 addon.xml)
repository_addon=$(cat repository.akmsubtitles/addon.xml)

printf "$prefix\n$addon\n$repository_addon\n$suffix\n" > packages/addons.xml
tr -d '\r' < packages/addons.xml | shasum | awk '{print $1}' > packages/addons.xml.crc
truncate -s -1 packages/addons.xml.crc
tr -d '\r' < packages/addons.xml | md5sum | awk '{print $1}' > packages/addons.xml.md5
truncate -s -1 packages/addons.xml.md5
cp packages/addons.xml.md5 packages/addons.xml.md5.txt

python ./scripts/update_changelog.py

exit
